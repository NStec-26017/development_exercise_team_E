<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.EmployeeRepository">

    <resultMap id="employeeResultMap" type="com.example.fullness.stationary.entity.Employee">
        <id property="id" column="id"/>
        <result property="departmentId" column="department_id"/>
        <result property="name" column="name"/>
        <result property="nameKana" column="name_kana"/>
        <association property="department" javaType="com.example.fullness.stationary.entity.Department">
            <id property="id" column="id"/>
            <result property="name" column="name"/>
        </association>
    </resultMap>

    <!-- 全社員を部署情報つきで取得する -->
    <select id="selectAll" resultMap="employeeResultMap">
        <![CDATA[
        SELECT *
        FROM employee e
        INNER JOIN department d ON e.department_id = d.id
        ORDER BY e.id
        ]]>
    </select>

    <!-- IDで社員を1件取得する -->
    <select id="selectById" resultMap="employeeResultMap">
        <![CDATA[
        SELECT *
        FROM employee e
        INNER JOIN department d ON e.department_id = d.id
        WHERE e.id = #{id}
        ]]>
    </select>

</mapper>
