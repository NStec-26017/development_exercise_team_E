<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.ProductStockRepository">
    <resultMap id="productStockResultMap" type = "com.example.fullness.stationary.entity.ProductStock">
            <id property="id" column="id"/>
            <result property="productId" column="product_id"/>
            <result property="quantity" column="quantity"/>
    </resultMap>

    <select id="selectAll" resultMap="productStockResultMap">
       <![CDATA[
       SELECT * FROM product_stock
       ]]>
    </select>

</mapper>