<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.ProductStockRepository">
    <resultMap id="productStockResultMap" type="com.example.fullness.stationary.entity.ProductStock">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
    </resultMap>


    <select id="selectProductStockJoin" resultType="java.util.HashMap">
        <![CDATA[
        SELECT
        p.price AS price,
        p.image_url AS image_url,
        p.delete_flag AS delete_flag,
        pc.name AS name,
        ps.quantity AS quantity
    FROM product p
    INNER JOIN product_category pc ON p.product_category_id = pc.id
    INNER JOIN product_stock ps ON p.id = ps.product_id
    WHERE delete_flag = 0
        ]]>
    </select>

    <select id="findById" resultMap="productStockResultMap">
        <![CDATA[
        SELECT *
        FROM product_stock
        WHERE product_id = #{productId}
        ]]>
    </select>

</mapper>