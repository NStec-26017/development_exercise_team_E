<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.ProductStockRepository">
 
 <!-- uc010 商品在庫を 1 件登録する。 -->
    <insert id="insertProductStockTen"
        parameterType="com.example.fullness.stationary.entity.ProductStock"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        <![CDATA[
            INSERT INTO product_stock
                (product_id, quantity)
            VALUES
                (#{productId}, #{quantity})
        ]]>
    </insert>

</mapper>