<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.fullness.stationary.repository.ProductStockRepository">

    <!-- product_stock テーブルから商品IDで在庫データを取得する -->
    <select id="selectByProductId" resultType="com.example.fullness.stationary.entity.ProductStock">
        <![CDATA[ 
        SELECT 
            id,
            product_id AS productId,
            quantity
        FROM product_stock 
        WHERE product_id = #{productId}
        ]]> 
    </select>

</mapper>